{
  "name": "industryflow-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3010",
    "build": "next build",
    "build:static": "node scripts/build-static.mjs",
    "test:e2e:static": "playwright test --config playwright.static.config.ts",
    "start": "next start --hostname 0.0.0.0 --port 3010",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test tests/research-cache.node.cjs tests/snapshot-routes.node.cjs tests/snapshot-leaks.node.cjs",
    "test:e2e": "playwright test",
    "test:e2e:offline": "playwright test --config playwright.offline.config.ts"
  },
  "dependencies": {
    "cytoscape": "3.34.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3"
  }
}
