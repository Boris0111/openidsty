# Generate a random password using scripts/setup-env.ps1. Never commit .env.
POSTGRES_PASSWORD=replace-with-random-local-password
APP_DATABASE=industry
APP_BIND=127.0.0.1
WEB_PORT=3010
API_PORT=8010
PREFECT_PORT=4201
# SEC requires a real contact email; leave blank to report configuration_required.
SEC_USER_AGENT=
# Only needed for the optional public profile:
PUBLIC_DOMAIN=example.com
ACME_EMAIL=
